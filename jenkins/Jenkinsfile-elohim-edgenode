// Elohim Edge Node Image Pipeline
//
// Builds a CUSTOM edgenode image from source: compiles the patched holochain
// conductor (our ethosengine/holochain fork) and swaps the
// binary into the holo-host edgenode base. This is the flexible, on-demand home
// for edgenode builds — separate from the elohim monorepo's edge DEPLOY pipeline
// (which is near the Jenkinsfile CPS size limit and also builds doorway+storage).
//
// ORCHESTRATED, NOT ONLY MANUAL. The elohim monorepo declares this job as the
// `elohim-conductor` pipeline (elohim/conductor-image/build-manifest.json) and
// dispatches it when a commit bumps the elohim/holochain-conductor or
// elohim/kitsune2 submodule pointer — passing the conductor pointer as HC_REF.
// The build then publishes `conductor-<sha12>`, which the monorepo edge
// pipeline resolves from the same pointer and bakes into elohim-storage. That
// chain is what makes a conductor bump reach the fleet with no hand-edited
// digest and no manual run of this job. Parameters below are also settable from
// a commit message via the [conductor:…] tag. Details:
// elohim/conductor-image/README.md in the monorepo.
//
// History: the 0.6 line carried the tx5/go-pion zombie-PeerConnection leak fix.
// Change HC_BRANCH to build a different conductor patch set.
//
// Pushes harbor.ethosengine.com/ethosengine/elohim-edgenode:{latest,<date>,<git>,hc-<HC_BRANCH>}.
//   NOTE: shares that Harbor repo with the monorepo edge pipeline, which pushes
//   distinct `1.0.0-dev-<hash>` tags (the deploy uses those specific tags, so it is
//   NOT affected). This job's tags are the custom from-source build; point a canary
//   leecher at a SPECIFIC tag from here. To fully isolate, change imageName below.
//   The 4th tag — `hc-<HC_BRANCH>` (`/` sanitized to `-` for OCI tag validity, e.g.
//   `hc-elohim-0.6.3`) — is a NAMED ROLLBACK ANCHOR: the date/git tags are
//   semantically anonymous, so at rollback time nobody can tell which one carries
//   which conductor line. Every non-profiling build overwrites its line's hc- tag
//   with the latest good build, so "roll back" = "point the STS at :hc-elohim-0.6".
//   Applies to both the edgenode image and the canary storage image (it embeds the
//   conductor); NOT applied to the -prof path (a one-off diagnostic canary, not a
//   rollback target). CAVEAT: Harbor's automated cleanup here only prunes dated
//   tags (keep 3); the org-wide Harbor retention policy (keep-5-latest-artifacts)
//   is untouched by this script and can still garbage-collect an untagged-elsewhere
//   hc- digest — durable retention needs an operator-side Harbor rule excluding
//   `hc-*` from that policy.
//
// ⚠ Verify the 0.7 conductor on a canary before fleet deploy — see the elohim
// deploy recipe.
@Library('imagebuilder-shared') _

pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr: '3', artifactNumToKeepStr: '3'))
        timeout(time: 90, unit: 'MINUTES')   // from-source holochain build is heavy
    }

    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: jenkins-deployer
  nodeSelector:
    node-type: edge
  volumes:
    - name: containerd-sock
      hostPath:
        path: /var/snap/microk8s/common/run/containerd.sock
        type: Socket
    - name: buildkit-run
      emptyDir: {}
    # Dedicated scratch for buildkit's OCI worker — the holochain from-source
    # build (cargo target) is ~20-30 GB, far larger than the devspaces
    # images, so it gets its own sized volume instead of the container rootfs.
    - name: buildkit-data
      emptyDir:
        sizeLimit: 60Gi
  containers:
    - name: builder
      image: harbor.ethosengine.com/ethosengine/ci-builder:latest
      command:
        - cat
      tty: true
      resources:
        requests:
          ephemeral-storage: "4Gi"
        limits:
          ephemeral-storage: "8Gi"
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
    - name: buildkitd
      image: harbor.ethosengine.com/proxy-dockerhub/moby/buildkit:v0.12.5
      securityContext:
        privileged: true
      args:
        - --addr
        - unix:///run/buildkit/buildkitd.sock
        - --oci-worker=true
        - --containerd-worker=false
        - --root
        - /var/lib/buildkit
      resources:
        requests:
          ephemeral-storage: "30Gi"
        limits:
          ephemeral-storage: "60Gi"
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
        - name: buildkit-data
          mountPath: /var/lib/buildkit
'''
        }
    }

    parameters {
        string(name: 'HC_BRANCH', defaultValue: 'elohim-0.7',
               description: 'ethosengine/holochain 0.7 conductor branch')
        string(name: 'HC_REF', defaultValue: '',
               description: 'EXACT holochain-fork commit to build (wins over HC_BRANCH). Set automatically by the elohim orchestrator to the SHA the monorepo\'s elohim/holochain-conductor submodule pointer records, which makes the image identity derive from committed source. When set, the build also publishes the source-derived pin tag `conductor-<sha12>` — the tag the monorepo edge pipeline bakes into elohim-storage. Leave empty for a branch-tip build (no pin tag published).')
        string(name: 'HC_FEATURES', defaultValue: 'encryption,wasmer-sys-cranelift,jemalloc',
               description: 'Conductor cargo --features. DEFAULT is the Holochain 0.7 production set: encryption + Cranelift + jemalloc, with schema omitted by --no-default-features. Iroh is the only transport and has no feature. Do NOT drop jemalloc. To build the debug heap-PROFILING canary, replace jemalloc with jemalloc-prof; profiling images remain isolated from the fleet tags.')
        booleanParam(name: 'BUILD_STORAGE_CANARY', defaultValue: false,
                     description: 'Also build the deployable storage image embedding the conductor (the consolidated elohim-node container runs the storage image). REQUIRED to get a kubectl-deployable artifact. Production (default jemalloc) → elohim-storage-zombiefix embedding elohim-edgenode:latest; profiling (jemalloc-prof) → isolated elohim-storage-prof embedding elohim-edgenode-prof. This is the artifact used to canary ONE anchor before the monorepo fleet roll.')
        booleanParam(name: 'SKIP_PUSH', defaultValue: false,
                     description: 'Build only, no Harbor push (validation)')
    }

    stages {
        stage('Checkout') {
            steps {
                container('builder') {
                    script {
                        checkout scm
                        sh 'git config --global --add safe.directory $(pwd)'
                        sh 'git clean -fdx'
                        sh 'git reset --hard HEAD'
                        echo "Building elohim-edgenode from che-devworkspaces ${env.BRANCH_NAME ?: 'main'}"
                        echo "  holochain fork branch: ${params.HC_BRANCH}"
                        echo "  conductor features:    ${params.HC_FEATURES}"
                        echo "  holochain fork ref:    ${params.HC_REF ?: '(branch tip)'}"
                    }
                }
            }
        }

        stage('Build & Push') {
            steps {
                container('builder') {
                    script {
                        // jemalloc-prof builds push ISOLATED image names so they never
                        // overwrite the fleet's elohim-edgenode:latest (which the monorepo
                        // storage embeds via CONDUCTOR_SOURCE_IMAGE). The PRODUCTION default
                        // (HC_FEATURES contains 'jemalloc', NOT 'jemalloc-prof') publishes
                        // :latest. Use 'jemalloc-prof' for a profiling canary; never drop
                        // jemalloc entirely — the bare glibc set re-leaks.
                        def profiling = params.HC_FEATURES.contains('jemalloc-prof')
                        env.EDGE_IMAGE = profiling ? 'elohim-edgenode-prof' : 'elohim-edgenode'
                        echo "  profiling build: ${profiling}  ->  image: ${env.EDGE_IMAGE}"
                        // Rolling named rollback anchor: production (non-prof) lines only.
                        env.HC_TAG = 'hc-' + params.HC_BRANCH.replaceAll('/', '-')
                        // SOURCE-DERIVED PIN TAG. When the orchestrator supplies HC_REF (the SHA
                        // the monorepo's elohim/holochain-conductor submodule pointer records), the
                        // image also gets `conductor-<sha12>` — the tag elohim-storage's Dockerfile
                        // resolves via --build-arg CONDUCTOR_SOURCE_IMAGE. That is what replaces the
                        // hand-edited sha256 digest pin: the committed submodule SHA IS the pin, so
                        // a conductor bump reaches the fleet without anyone editing a Dockerfile.
                        // Holochain 0.7 has one iroh transport line, so the conductor SHA alone
                        // determines this source-derived tag. (elohim/kitsune2 is NOT in the tag:
                        // its sibling-clone path patches are commented out in the fork's
                        // Cargo.toml, so that submodule is reference-only.)
                        // Profiling builds publish NO pin tag at all — a diagnostic canary is not
                        // a deploy source, matching rollbackTags below.
                        env.CONDUCTOR_PIN_TAG = (params.HC_REF && !profiling)
                            ? 'conductor-' + params.HC_REF.take(12)
                            : ''
                        if (env.CONDUCTOR_PIN_TAG) {
                            echo "  source-derived pin tag: ${env.CONDUCTOR_PIN_TAG}"
                        } else if (profiling) {
                            echo "  profiling build → no pin tag (diagnostic canary, not a deploy source)"
                        } else {
                            echo "  no HC_REF → no pin tag; the monorepo edge build will NOT pick this up"
                        }
                        def rollbackTags = profiling ? [] : [env.HC_TAG]
                        if (env.CONDUCTOR_PIN_TAG) rollbackTags.add(env.CONDUCTOR_PIN_TAG)
                        def result = buildDevspaceImage(
                            imageName: env.EDGE_IMAGE,
                            dockerfile: 'containers/elohim-edgenode',
                            registry: 'harbor.ethosengine.com/ethosengine',
                            buildArgs: [HC_BRANCH: params.HC_BRANCH, HC_FEATURES: params.HC_FEATURES,
                                        HC_REF: params.HC_REF],
                            skipBaseImageCheck: true,   // trigger is the fork commits, not the holo-host base
                            forceBuild: true,
                            skipPush: params.SKIP_PUSH,
                            extraTags: rollbackTags
                        )
                        env.BUILD_RESULT = result.skipped ? 'SKIPPED' : 'SUCCESS'
                    }
                }
            }
        }

        stage('Build & Push Canary Storage') {
            when { expression { params.BUILD_STORAGE_CANARY && !params.SKIP_PUSH } }
            steps {
                container('builder') {
                    script {
                        // Fast binary swap (no Rust rebuild): production storage SERVICE
                        // (unchanged) + the conductor this run just built. This is the artifact
                        // deployed to the consolidated elohim-node container.
                        // Profiling (jemalloc-prof) → isolated name elohim-storage-prof, and we
                        // must point CONDUCTOR_SOURCE at the isolated elohim-edgenode-prof (the
                        // Dockerfile default is edgenode:latest = the fleet jemalloc conductor,
                        // which a prof run does NOT push). Production (default jemalloc) →
                        // unchanged elohim-storage-zombiefix + defaults (embeds edgenode:latest).
                        def profiling = params.HC_FEATURES.contains('jemalloc-prof')
                        def storageImage = profiling ? 'elohim-storage-prof' : 'elohim-storage-zombiefix'
                        def storageArgs = profiling ? [CONDUCTOR_SOURCE: 'harbor.ethosengine.com/ethosengine/elohim-edgenode-prof:latest'] : [:]
                        // This image embeds the conductor built above (CONDUCTOR_SOURCE_IMAGE
                        // COPY), so it carries the same rollback-anchor treatment — production
                        // line only, matching the edgenode stage above.
                        def rollbackTags = profiling ? [] : [env.HC_TAG]
                        if (env.CONDUCTOR_PIN_TAG) rollbackTags.add(env.CONDUCTOR_PIN_TAG)
                        buildDevspaceImage(
                            imageName: storageImage,
                            dockerfile: 'containers/elohim-storage-zombiefix',
                            registry: 'harbor.ethosengine.com/ethosengine',
                            buildArgs: storageArgs,
                            skipBaseImageCheck: true,
                            forceBuild: true,
                            skipPush: params.SKIP_PUSH,
                            extraTags: rollbackTags
                        )
                        echo "Canary storage: harbor.ethosengine.com/ethosengine/${storageImage}:{latest,${env.IMAGE_TAG_DATED},${env.IMAGE_TAG_GIT}} = elohim-storage:dev-latest + ${profiling ? 'PROFILING (jemalloc-prof)' : 'patched'} conductor"
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                echo "✅ elohim-edgenode: ${env.BUILD_RESULT}"
                if (env.IMAGE_TAG_GIT) {
                    def rollbackTag = params.HC_FEATURES.contains('jemalloc-prof') ? null : env.HC_TAG
                    def tagList = rollbackTag ? "latest,${env.IMAGE_TAG_DATED},${env.IMAGE_TAG_GIT},${rollbackTag}" : "latest,${env.IMAGE_TAG_DATED},${env.IMAGE_TAG_GIT}"
                    if (env.CONDUCTOR_PIN_TAG) tagList += ",${env.CONDUCTOR_PIN_TAG}"
                    echo "Pushed harbor.ethosengine.com/ethosengine/${env.EDGE_IMAGE ?: 'elohim-edgenode'}:{${tagList}}"
                    if (env.CONDUCTOR_PIN_TAG) {
                        echo "Pin tag ${env.CONDUCTOR_PIN_TAG} is what the monorepo edge build resolves for CONDUCTOR_SOURCE_IMAGE — the fleet picks this conductor up on the next elohim-edge run with no Dockerfile edit."
                    }
                    echo "Canary one non-genesis leecher at a specific tag; watch smaps_anon{class=other} flatten + stay in-mesh; roll, genesis pair last."
                }
            }
        }
    }
}
