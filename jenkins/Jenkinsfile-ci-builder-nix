// CI Builder Nix Image Pipeline
// Extends ci-builder with Nix package manager for Holochain DNA builds
@Library('imagebuilder-shared') _

pipeline {
    options {
        buildDiscarder(logRotator(numToKeepStr: '3', artifactNumToKeepStr: '3'))
    }

    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: jenkins-deployer
  nodeSelector:
    node-type: edge
  volumes:
    - name: containerd-sock
      hostPath:
        path: /var/snap/microk8s/common/run/containerd.sock
        type: Socket
    - name: buildkit-run
      emptyDir: {}
  containers:
    - name: builder
      image: harbor.ethosengine.com/ethosengine/ci-builder:latest
      command:
        - cat
      tty: true
      resources:
        requests:
          ephemeral-storage: "2Gi"
        limits:
          ephemeral-storage: "4Gi"
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
    - name: buildkitd
      image: moby/buildkit:v0.12.5
      securityContext:
        privileged: true
      args:
        - --addr
        - unix:///run/buildkit/buildkitd.sock
        - --oci-worker=true
        - --containerd-worker=false
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
'''
        }
    }

    parameters {
        string(name: 'BASE_TAG', defaultValue: 'latest',
               description: 'ci-builder tag to extend from (use dated tag for specific version)')
        booleanParam(name: 'FORCE_BUILD', defaultValue: false,
                     description: 'Force rebuild even if no changes')
        booleanParam(name: 'SKIP_PUSH', defaultValue: false,
                     description: 'Skip pushing to Harbor (testing only)')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false,
                     description: 'Skip Harbor security scanning')
        booleanParam(name: 'SKIP_SMOKE_TESTS', defaultValue: false,
                     description: 'Skip smoke tests')
    }

    triggers {
        // Poll SCM every 5 minutes so a change scoped to ci-builder-nix
        // (without a ci-builder change) still triggers a rebuild — the
        // ci-builder → ci-builder-nix cascade only fires when ci-builder
        // itself rebuilds, which left this pipeline stale 2025-12 → 2026-05
        // when the sccache layer was added in commit 59c50f8.
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                container('builder') {
                    script {
                        checkout scm
                        sh 'git config --global --add safe.directory $(pwd)'
                        sh 'git clean -fdx'
                        sh 'git reset --hard HEAD'
                        echo "Building from branch: ${env.BRANCH_NAME ?: 'main'}"
                    }
                }
            }
        }

        stage('Build & Push') {
            steps {
                container('builder') {
                    script {
                        def result = buildDevspaceImage(
                            imageName: 'ci-builder-nix',
                            dockerfile: 'containers/ci-builder/ci-builder-nix',
                            registry: 'harbor.ethosengine.com/ethosengine',
                            baseImage: "harbor.ethosengine.com/ethosengine/ci-builder:${params.BASE_TAG}",
                            buildArgs: [BASE_TAG: params.BASE_TAG],
                            skipBaseImageCheck: true,  // We control this via BASE_TAG parameter
                            forceBuild: params.FORCE_BUILD,
                            skipPush: params.SKIP_PUSH,
                            skipSecurityScan: params.SKIP_SECURITY_SCAN,
                            skipSmokeTests: params.SKIP_SMOKE_TESTS
                        )

                        env.BUILD_RESULT = result.skipped ? 'SKIPPED' : 'SUCCESS'
                        env.IMAGE_NAME = result.fullImageName

                        // Cascade to next link. ci-playwright is the tail.
                        // Tolerate the downstream job not existing yet — a
                        // missing item shouldn't turn this build red.
                        if (!result.skipped && !params.SKIP_PUSH) {
                            try {
                                echo 'ci-builder-nix updated — triggering devspaces-ci-playwright'
                                build job: 'devspaces-ci-playwright', wait: false
                            } catch (err) {
                                echo "⚠️  Cascade trigger skipped: ${err.message}"
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            container('builder') {
                script {
                    if (env.IMAGE_TAG_DATED && env.IMAGE_TAG_GIT) {
                        sh """
                            set +e
                            nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/ci-builder-nix:latest 2>/dev/null || true
                            nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/ci-builder-nix:${IMAGE_TAG_DATED} 2>/dev/null || true
                            nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/ci-builder-nix:${IMAGE_TAG_GIT} 2>/dev/null || true
                        """
                    }
                }
            }
        }
        success {
            script {
                echo "✅ ci-builder-nix pipeline completed: ${env.BUILD_RESULT}"
                if (env.IMAGE_NAME) {
                    echo "Image: ${env.IMAGE_NAME}"
                }
            }
        }
    }
}
