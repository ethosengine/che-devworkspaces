// Base Developer Image (x86-64-v2) Pipeline
//
// Root of the v2 chain: base-developer-v2 -> udi-plus -> udi-plus-mem -> udi-plus-mem-rust-nix
// Built from containers/base-developer-v2/Dockerfile (AlmaLinux 10, platform
// linux/amd64/v2), for hosts without AVX2 (shem). See
// docs/2026-10-01-x86-64-v2-workspace-image-plan.md.
// Triggers devspaces-udi-plus (VARIANT=v2) downstream on successful publish.
// No timer: the v2 chain is built on demand, never from the default cascade.
// Tags are plain (latest/dated/git) in the base-developer-v2 repository, which
// nothing else uses; the smoke on shem gates the v2-latest tags of the layers above.
@Library('imagebuilder-shared') _

pipeline {
    options {
        disableConcurrentBuilds()
    }

    agent none

    parameters {
        booleanParam(name: 'FORCE_BUILD', defaultValue: false,
                     description: 'Force rebuild')
        booleanParam(name: 'SKIP_PUSH', defaultValue: false,
                     description: 'Skip pushing to Harbor')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false,
                     description: 'Skip security scanning')
        booleanParam(name: 'SKIP_SMOKE_TESTS', defaultValue: false,
                     description: 'Skip smoke tests')
    }

    stages {
        stage('Image') {
            agent {
                kubernetes {
                    cloud 'kubernetes'
                    yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          serviceAccount: jenkins-deployer
          nodeSelector:
            node-type: edge
          volumes:
            - name: containerd-sock
              hostPath:
                path: /var/snap/microk8s/common/run/containerd.sock
                type: Socket
            - name: buildkit-run
              emptyDir: {}
          containers:
            - name: builder
              image: harbor.ethosengine.com/ethosengine/ci-builder:latest
              command:
                - cat
              tty: true
              resources:
                requests:
                  ephemeral-storage: "4Gi"
                limits:
                  ephemeral-storage: "8Gi"
              volumeMounts:
                - name: containerd-sock
                  mountPath: /run/containerd/containerd.sock
                - name: buildkit-run
                  mountPath: /run/buildkit
            - name: buildkitd
              image: harbor.ethosengine.com/proxy-dockerhub/moby/buildkit:v0.12.5
              securityContext:
                privileged: true
              args:
                - --addr
                - unix:///run/buildkit/buildkitd.sock
                - --oci-worker=true
                - --containerd-worker=false
              volumeMounts:
                - name: containerd-sock
                  mountPath: /run/containerd/containerd.sock
                - name: buildkit-run
                  mountPath: /run/buildkit
        '''
                }
            }
            stages {
                stage('Checkout') {
                    steps {
                        container('builder') {
                            script {
                                checkout scm
                                sh 'git config --global --add safe.directory $(pwd)'
                                sh 'git clean -fdx'
                                sh 'git reset --hard HEAD'
                                echo "Building from branch: ${env.BRANCH_NAME ?: 'main'}"
                            }
                        }
                    }
                }

                stage('Build & Push') {
                    steps {
                        container('builder') {
                            script {
                                def result = buildDevspaceImage(
                                    imageName: 'base-developer-v2',
                                    dockerfile: 'containers/base-developer-v2',
                                    registry: 'harbor.ethosengine.com/devspaces',
                                    // MUST match the final stage's FROM in
                                    // containers/base-developer-v2/Dockerfile. The upstream
                                    // devfile base (copied from, never run) is not tracked
                                    // here: use FORCE_BUILD to pick up upstream script changes.
                                    baseImage: 'harbor.ethosengine.com/proxy-quay/almalinuxorg/almalinux:10',
                                    forceBuild: params.FORCE_BUILD,
                                    skipPush: params.SKIP_PUSH,
                                    skipSecurityScan: params.SKIP_SECURITY_SCAN,
                                    skipSmokeTests: params.SKIP_SMOKE_TESTS
                                )

                                env.BUILD_RESULT = result.skipped ? 'SKIPPED' : 'SUCCESS'
                                env.IMAGE_NAME = result.fullImageName
                            }
                        }
                    }
                }
            }

            post {
                always {
                    container('builder') {
                        script {
                            def img = 'harbor.ethosengine.com/devspaces/base-developer-v2'
                            if (env.IMAGE_TAG_DATED && env.IMAGE_TAG_GIT) {
                                sh """
                                    set +e
                                    nerdctl -n k8s.io rmi ${img}:latest 2>/dev/null || true
                                    nerdctl -n k8s.io rmi ${img}:${IMAGE_TAG_DATED} 2>/dev/null || true
                                    nerdctl -n k8s.io rmi ${img}:${IMAGE_TAG_GIT} 2>/dev/null || true
                                """
                            }
                        }
                    }
                }
                success {
                    script {
                        echo "base-developer-v2 pipeline completed: ${env.BUILD_RESULT}"
                        if (env.IMAGE_NAME) {
                            echo "Image: ${env.IMAGE_NAME}"
                        }
                    }
                }
            }
        }

        // No agent here: release the parent's BuildKit pod before waiting.
        stage('Downstream') {
            steps {
                script {
                    if (env.BUILD_RESULT == 'SUCCESS' && !params.SKIP_PUSH) {
                        echo 'base-developer-v2 updated - building the v2 chain from udi-plus'
                        build job: '/devspaces-udi-plus/main', wait: true, parameters: [string(name: 'VARIANT', value: 'v2')]
                    }
                }
            }
        }
    }
}
