// UDI Plus + MemPalace Image Pipeline
//
// Layer: udi-plus -> udi-plus-mem
// Built from containers/udi-plus-mem/Dockerfile.
// Triggers devspaces-udi-plus-mem-rust-nix downstream on successful publish.
@Library('imagebuilder-shared') _

pipeline {
    options {
        disableConcurrentBuilds()
    }

    agent none

    parameters {
        string(name: 'BASE_TAG', defaultValue: 'latest',
               description: 'udi-plus tag to build from (use dated tag after udi-plus rebuild)')
        booleanParam(name: 'FORCE_BUILD', defaultValue: false,
                     description: 'Force rebuild')
        booleanParam(name: 'SKIP_PUSH', defaultValue: false,
                     description: 'Skip pushing to Harbor')
        booleanParam(name: 'SKIP_SECURITY_SCAN', defaultValue: false,
                     description: 'Skip security scanning')
        booleanParam(name: 'SKIP_SMOKE_TESTS', defaultValue: false,
                     description: 'Skip smoke tests')
        choice(name: 'VARIANT', choices: ['default', 'v2'],
               description: 'default = the UBI10 chain on latest. v2 = the x86-64-v2 chain (runs on shem): tags are v2-prefixed, latest is never touched, and v2-latest moves only after the smoke on shem passes.')
    }

    stages {
        stage('Image') {
            agent {
                kubernetes {
                    cloud 'kubernetes'
                    yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          serviceAccount: jenkins-deployer
          nodeSelector:
            node-type: edge
          volumes:
            - name: containerd-sock
              hostPath:
                path: /var/snap/microk8s/common/run/containerd.sock
                type: Socket
            - name: buildkit-run
              emptyDir: {}
          containers:
            - name: builder
              image: harbor.ethosengine.com/ethosengine/ci-builder:latest
              command:
                - cat
              tty: true
              resources:
                requests:
                  ephemeral-storage: "4Gi"
                limits:
                  ephemeral-storage: "8Gi"
              volumeMounts:
                - name: containerd-sock
                  mountPath: /run/containerd/containerd.sock
                - name: buildkit-run
                  mountPath: /run/buildkit
            - name: buildkitd
              image: harbor.ethosengine.com/proxy-dockerhub/moby/buildkit:v0.12.5
              securityContext:
                privileged: true
              args:
                - --addr
                - unix:///run/buildkit/buildkitd.sock
                - --oci-worker=true
                - --containerd-worker=false
              volumeMounts:
                - name: containerd-sock
                  mountPath: /run/containerd/containerd.sock
                - name: buildkit-run
                  mountPath: /run/buildkit
        '''
                }
            }
            stages {
                stage('Checkout') {
                    steps {
                        container('builder') {
                            script {
                                checkout scm
                                sh 'git config --global --add safe.directory $(pwd)'
                                sh 'git clean -fdx'
                                sh 'git reset --hard HEAD'
                                echo "Building from branch: ${env.BRANCH_NAME ?: 'main'}"
                            }
                        }
                    }
                }

                stage('Build & Push') {
                    steps {
                        container('builder') {
                            script {
                                if (params.VARIANT == 'v2' && !params.BASE_TAG.startsWith('v2-')) {
                                    error("VARIANT=v2 needs a v2- BASE_TAG (e.g. v2-latest), got '${params.BASE_TAG}'")
                                }
                                if (params.VARIANT != 'v2' && params.BASE_TAG.startsWith('v2-')) {
                                    error("BASE_TAG '${params.BASE_TAG}' is a v2 tag; set VARIANT=v2")
                                }
                                def result = buildDevspaceImage(
                                    imageName: 'udi-plus-mem',
                                    dockerfile: 'containers/udi-plus-mem',
                                    registry: 'harbor.ethosengine.com/devspaces',
                                    baseImage: "harbor.ethosengine.com/devspaces/udi-plus:${params.BASE_TAG}",
                                    buildArgs: [BASE_TAG: params.BASE_TAG],
                                    skipBaseImageCheck: true,  // controlled via BASE_TAG parameter
                                    tagPrefix: params.VARIANT == 'v2' ? 'v2-' : '',
                                    holdLatest: params.VARIANT == 'v2',
                                    forceBuild: params.FORCE_BUILD,
                                    skipPush: params.SKIP_PUSH,
                                    skipSecurityScan: params.SKIP_SECURITY_SCAN,
                                    skipSmokeTests: params.SKIP_SMOKE_TESTS
                                )

                                env.BUILD_RESULT = result.skipped ? 'SKIPPED' : 'SUCCESS'
                                env.IMAGE_NAME = result.fullImageName

                            }
                        }
                    }
                }
            }

            post {
                always {
                    container('builder') {
                        script {
                            def img = 'harbor.ethosengine.com/devspaces/udi-plus-mem'
                            if (env.IMAGE_TAG_DATED && env.IMAGE_TAG_GIT) {
                                sh """
                                    set +e
                                    nerdctl -n k8s.io rmi ${img}:${IMAGE_TAG_LATEST} 2>/dev/null || true
                                    nerdctl -n k8s.io rmi ${img}:${IMAGE_TAG_DATED} 2>/dev/null || true
                                    nerdctl -n k8s.io rmi ${img}:${IMAGE_TAG_GIT} 2>/dev/null || true
                                """
                            }
                        }
                    }
                }
                success {
                    script {
                        echo "udi-plus-mem pipeline completed: ${env.BUILD_RESULT}"
                        if (env.IMAGE_NAME) {
                            echo "Image: ${env.IMAGE_NAME}"
                        }
                    }
                }
            }
        }

        // v2 only: run the candidate on shem (x86-64-v2), then promote it.
        // No agent here: the library opens its own pods.
        stage('Smoke on shem') {
            when {
                expression { params.VARIANT == 'v2' && env.BUILD_RESULT == 'SUCCESS' && !params.SKIP_PUSH }
            }
            steps {
                script {
                    smokeAndPromoteDevspaceImage(
                        imageName: 'udi-plus-mem',
                        candidateTag: env.IMAGE_TAG_GIT,
                        promoteTag: env.IMAGE_TAG_LATEST,
                        registry: 'harbor.ethosengine.com/devspaces'
                    )
                }
            }
        }

        // No agent here: release the parent's BuildKit pod before waiting.
        stage('Downstream') {
            steps {
                script {
                    // Trigger downstream mem-rust-nix build if mem was updated.
                    if (env.BUILD_RESULT == 'SUCCESS' && !params.SKIP_PUSH) {
                        echo 'udi-plus-mem updated - building downstream udi-plus-mem-rust-nix'
                        if (params.VARIANT == 'v2') {
                            build job: '/devspaces-udi-plus-mem-rust-nix/main', wait: true, parameters: [string(name: 'VARIANT', value: 'v2'), string(name: 'BASE_TAG', value: 'v2-latest')]
                        } else {
                            build job: '/devspaces-udi-plus-mem-rust-nix/main', wait: true
                        }
                    }
                }
            }
        }
    }
}
